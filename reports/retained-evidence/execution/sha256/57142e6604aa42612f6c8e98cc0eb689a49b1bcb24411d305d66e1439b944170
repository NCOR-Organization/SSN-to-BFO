  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000393">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000387"/>
    <rdfs:label xml:lang="en">Yaw Axis</rdfs:label>
    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/GeospatialOntology</ns4:ont00001760>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">An Axis of Rotation that passes through the center of an object's Mass from the top to the bottom and is perpendicular to the direction of the object's motion. For objects in Orbit, the Yaw Axis passes through the Barycenter of its Orbit.</skos:definition>
    <skos:altLabel xml:lang="en">Vertical Axis</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000418">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000005"/>
    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/EventOntology</ns4:ont00001760>
    <rdfs:label xml:lang="en">Biographical Life</rdfs:label>
    <skos:definition xml:lang="en">An Act composed of the Life Events that occur during the course of existence of an Agent (i.e. Person or Organization).</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
