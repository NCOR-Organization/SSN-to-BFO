  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001138">
    <rdfs:label xml:lang="en">Beverage Antenna</rdfs:label>
    <skos:definition xml:lang="en">A Wire Antenna that consists of a horizontal wire one-half to two wavelengths long that is suspended above the ground with one end attached to the receiver feedline and the other grounded and which is typically used in the low and medium frequency radio bands.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns4:ont00001754>Adapted from: https://en.wikipedia.org/wiki/Beverage_antenna</ns4:ont00001754>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000499"/>
    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/ArtifactOntology</ns4:ont00001760>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001597">
