    <ns4:ont00001754 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Internal_combustion_engine&amp;oldid=1063281505</ns4:ont00001754>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A Combustion Engine that is designed to have an internal Combustion Chamber where portions of Fuel and Oxidizer mixture are burned to generate thermal energy that is then converted into mechanical energy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000590">
    <rdfs:label xml:lang="en">Convex Shape</rdfs:label>
    <skos:definition xml:lang="en">A Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line connecting a pair of points on the surface of the bearer will lie outside.</skos:definition>
    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/QualityOntology</ns4:ont00001760>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001059"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000015">
    <ns4:ont00001754 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Shotgun&amp;oldid=1062571691</ns4:ont00001754>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001104"/>
    <rdfs:label xml:lang="en">Shotgun</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/ArtifactOntology</ns4:ont00001760>
    <skos:definition xml:lang="en">A Long Gun that fires packets of shot, a single slug, a sabot, or a specialty round (such as tear gas, bolo shell, or a breaching round) over shorter ranges than that of Rifles and with less accuracy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001289">
    <skos:definition xml:lang="en">A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has suffered impairment (i.e., a decrease or loss) due to a previous action or event such that the Independent Continuant is now of lesser value, usefulness, or functionality.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:altLabel xml:lang="en">Injured</skos:altLabel>
    <skos:altLabel xml:lang="en">Compromised</skos:altLabel>
    <skos:altLabel xml:lang="en">Damaged</skos:altLabel>
    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/EventOntology</ns4:ont00001760>
    <ns4:ont00001754>http://www.thefreedictionary.com/damaged</ns4:ont00001754>
    <rdfs:label xml:lang="en">Damaged Stasis</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000135"/>
    <skos:scopeNote xml:lang="en">This class can be used to instantiate instances that might otherwise be treated by defined classes such as Damaged Vehicle or Wounded Person. The Independent Continuant and Quality or Realizable Entity are participants of the stasis which can in turn be related to the temporal interval via the occurs on property. </skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nae71b70bdce647169d0d77c58f83f1b4b33">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="nae71b70bdce647169d0d77c58f83f1b4b35"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000226">
    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/FacilityOntology</ns4:ont00001760>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000192"/>
    <ns4:ont00001754 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/w/index.php?title=Transport&amp;oldid=1063526665</ns4:ont00001754>
    <skos:definition xml:lang="en">A Facility that is designed for commencing or concluding the transportation of transportation artifacts, or for housing transportation artifacts.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Transportation Facility</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000237">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">An Act of Training Acquisition performed by an Agent by acquiring knowledge of the tactics, techniques, and/or strategies of the use of violence against civilians in order to attain goals that are political, religous, or ideological in nature from an Agent or communication medium that realizes a capacity derived from its affiliation with a Terrorist Organization.</skos:definition>
    <rdfs:label xml:lang="en">Act of Terrorist Training Acquisition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000687"/>
    <ns4:ont00001754>http://wordnetweb.princeton.edu/perl/webwn?s=terrorism</ns4:ont00001754>
    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/EventOntology</ns4:ont00001760>
  </rdf:Description>
