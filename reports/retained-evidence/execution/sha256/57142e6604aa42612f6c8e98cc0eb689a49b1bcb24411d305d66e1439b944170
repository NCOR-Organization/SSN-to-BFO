  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001379">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Agent Capability</rdfs:label>
    <ns4:ont00001754 xml:lang="en">Schlosser, Markus, "Agency", The Stanford Encyclopedia of Philosophy (Winter 2019 Edition), Edward N. Zalta (ed.), available at: https://plato.stanford.edu/archives/win2019/entries/agency/</ns4:ont00001754>
