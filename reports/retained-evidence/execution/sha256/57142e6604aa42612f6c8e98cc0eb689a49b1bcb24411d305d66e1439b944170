    <ns4:ont00001754>http://purl.obolibrary.org/obo/IAO_0000030</ns4:ont00001754>
    <rdfs:label xml:lang="en">Information Content Entity</rdfs:label>
    <owl:equivalentClass rdf:nodeID="nae71b70bdce647169d0d77c58f83f1b4b414"/>
  </rdf:Description>
