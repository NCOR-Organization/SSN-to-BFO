    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/ArtifactOntology</ns4:ont00001760>
    <rdfs:label xml:lang="en">Polarizing Prism</rdfs:label>
    <skos:definition xml:lang="en">A Prism designed to split a beam of light entering the Prism into components of varying polarization.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000804"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000279">
    <skos:definition xml:lang="en">An Allegiance Role that inheres in an Agent by virtue of that Agent having committed offensive Acts or exhibited intent to perform such Acts towards a particular Agent or Group of Agents or has been declared as hostile by some appropriate authority.</skos:definition>
