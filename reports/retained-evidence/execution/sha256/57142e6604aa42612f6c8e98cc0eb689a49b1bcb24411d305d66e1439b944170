  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001962">
    <rdfs:label xml:lang="en">process started by</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:scopeNote xml:lang="en">A process x is started by another process y when y causes x while y is still occurring.</skos:scopeNote>
    <skos:definition xml:lang="en">x process_started_by y iff x and y are instances of processes, and x is caused_by y, and i is an instance of a temporal instant, and r is an instant of a temporal interval, and x has starting instance i, and y occurs on r, and r interval contains i.</skos:definition>
