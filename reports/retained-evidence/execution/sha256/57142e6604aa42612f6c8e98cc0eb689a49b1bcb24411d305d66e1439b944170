  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001338">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000862"/>
    <skos:definition xml:lang="en">A Sound Process Profile that is characterized by the variation, spectrum, or envelope of translated sound waves, typically on a continuum from dull or dark to bright.</skos:definition>
