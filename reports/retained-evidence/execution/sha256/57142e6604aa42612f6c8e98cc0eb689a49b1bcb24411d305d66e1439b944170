  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00000710">
    <ns4:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/FacilityOntology</ns4:ont00001760>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Command Post Facility</rdfs:label>
    <skos:definition xml:lang="en">A Military Facility that is designed to support the command and control of Military Operations or Forces.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001052"/>
    <ns4:ont00001754>http://www.dictionary.com/browse/command-post</ns4:ont00001754>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001424">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://www.commoncoreontologies.org/ont00001235"/>
